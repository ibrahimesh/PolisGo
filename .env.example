# Copy this file to .env (which is git-ignored) and fill in every empty value
# before running `docker compose up --build`. The secrets are empty on
# purpose: compose refuses to start until each one is set, so no example
# value can end up guarding a real database.

# SQL Server SA password. MSSQL requires at least 8 characters with at least
# three of: upper case, lower case, digit, symbol.
SQL_SA_PASSWORD=

# JWT signing key, at least 32 characters (the API fails fast at startup
# otherwise). Generate a fresh one, for example:
#   macOS/Linux:  openssl rand -base64 48
#   PowerShell:   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))
JWT_SECRET_KEY=

# Development admin bootstrap. The compose stack runs with
# ASPNETCORE_ENVIRONMENT=Development so the DatabaseSeeder picks these up.
# The password follows the registration rules (8-64 characters, upper case,
# lower case and a digit).
SEED_ADMIN_EMAIL=admin@polisgo.local
SEED_ADMIN_PASSWORD=

# Only for the demo data (docker-compose.demo.yml): the password every demo
# account (agents, adjusters, clients) shares. DEMO ACCOUNTS, NOT FOR
# PRODUCTION; never the admin password above.
DEMO_PASSWORD=
