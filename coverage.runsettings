<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage for CI's summary: generated EF migrations are excluded, since
     they are two thirds of the lines and no test is meant to cover them. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
