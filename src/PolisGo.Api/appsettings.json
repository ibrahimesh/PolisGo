{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PolisGo",
    "Audience": "PolisGo.Clients",
    "SecretKey": "SET-VIA-USER-SECRETS",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ErrorTracking": {
    "MaxOccurrencesPerGroup": 20,
    "QueueCapacity": 1000,
    "BatchSize": 100,
    "OccurrenceRetentionDays": 30,
    "CounterRetentionDays": 90,
    "MaxNewClientGroupsPerHour": 50
  },
  "RateLimits": {
    "SignIn": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "PasswordChange": { "PermitLimit": 5, "WindowSeconds": 900 }
  }
}
